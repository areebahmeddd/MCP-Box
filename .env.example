# API Configurations
SUPERBOX_API_URL=http://localhost:8000/api/v1

# Cloudflare Configurations
CLOUDFLARE_ACCOUNT_ID=cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=superbox-mcp-registry
CLOUDFLARE_WORKER_URL=https://superbox-executor.your-subdomain.workers.dev

# Firebase Configurations
FIREBASE_API_KEY=firebase_api_key
FIREBASE_PROJECT_ID=firebase_project_id

# OAuth Configurations
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret

# Scanners Configurations
SONAR_TOKEN=sonar_token
SONAR_ORGANIZATION=sonar_organization
SNYK_API_TOKEN=snyk_api_token
GITGUARDIAN_API_KEY=gitguardian_api_key

# Razorpay Configurations
RAZORPAY_KEY_ID=razorpay_key_id
RAZORPAY_KEY_SECRET=razorpay_key_secret
